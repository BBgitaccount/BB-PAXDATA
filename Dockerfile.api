# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

# Speed up package downloads using Turkish Debian mirror
RUN sed -i 's/deb.debian.org/ftp.tr.debian.org/g' /etc/apt/sources.list.d/debian.sources || sed -i 's/deb.debian.org/ftp.tr.debian.org/g' /etc/apt/sources.list

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install poetry using pip cache mount
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install poetry

# Copy project specifications
COPY pyproject.toml poetry.lock /app/

# Set Poetry and pip network timeout to prevent timeouts
ENV POETRY_HTTP_TIMEOUT=1200
ENV PIP_DEFAULT_TIMEOUT=1200

# Disable poetry virtualenvs creation, disable parallel installs to prevent network choking & install dependencies using cache mount
RUN --mount=type=cache,target=/root/.cache/pypoetry \
    poetry config virtualenvs.create false \
    && poetry config installer.parallel false \
    && poetry install --no-interaction --no-ansi --no-root

# Copy local models directory if present in build context to make offline spaCy model wheels available
COPY docker /app/docker

# Install spaCy models, using local wheels if available, otherwise downloading with pip caching
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -f /app/docker/models/en_core_web_lg-3.8.0-py3-none-any.whl ] && [ -f /app/docker/models/tr_core_news_md-1.0-py3-none-any.whl ]; then \
        echo "Installing spaCy models from local wheels..."; \
        pip install /app/docker/models/en_core_web_lg-3.8.0-py3-none-any.whl /app/docker/models/tr_core_news_md-1.0-py3-none-any.whl; \
    else \
        echo "Local wheels not found. Downloading spaCy models from remote URLs..."; \
        pip install \
            https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl \
            https://huggingface.co/turkish-nlp-suite/tr_core_news_md/resolve/main/tr_core_news_md-1.0-py3-none-any.whl; \
    fi

# Copy full application code
COPY . /app

# Install project root using cache mount
RUN --mount=type=cache,target=/root/.cache/pypoetry \
    poetry install --no-interaction --no-ansi

EXPOSE 8000

# Start app using uvicorn reload mode for development
CMD ["uvicorn", "bb_paxdata.interfaces.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
