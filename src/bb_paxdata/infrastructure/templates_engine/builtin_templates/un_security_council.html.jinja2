<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNSC Analysis Report</title>
    <style>
        body { font-family: 'Times New Roman', serif; margin: 40px; line-height: 1.6; }
        .header { text-align: center; border-bottom: 2px solid #1F3864; padding-bottom: 20px; margin-bottom: 30px; }
        .classification { color: #8B0000; font-weight: bold; text-transform: uppercase; }
        .section { margin-bottom: 30px; }
        .section h2 { color: #1F3864; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
        .speaker-card { border: 1px solid #ddd; padding: 15px; margin: 10px 0; background: #f9f9f9; }
        .risk-high { color: #8B0000; font-weight: bold; }
        .risk-medium { color: #FF8C00; font-weight: bold; }
        .risk-low { color: #228B22; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin: 15px 0; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #1F3864; color: white; }
    </style>
</head>
<body>
    <div class="header">
        <h1>UN Security Council Analysis Report</h1>
        <p><strong>Session:</strong> {{ session.title }}</p>
        <p><strong>Date:</strong> {{ session.date | format_date }}</p>
        <p><strong>Location:</strong> {{ session.location }}</p>
        <p class="classification">{{ session.classification }}</p>
    </div>

    <div class="section">
        <h2>Executive Summary</h2>
        <p>{{ analysis.summary }}</p>
    </div>

    <div class="section">
        <h2>Speaker-Based SBI Analysis</h2>
        {% for speaker in speakers | sort(attribute='avg_risk_score', reverse=true) %}
        <div class="speaker-card">
            <h3>{{ speaker.name }} ({{ speaker.country }})</h3>
            <ul>
                <li><strong>Statements:</strong> {{ speaker.statement_count }}</li>
                <li><strong>SBI Distribution:</strong> 
                    Statement: {{ analysis.sbi.S }}% | 
                    Behavior: {{ analysis.sbi.B }}% | 
                    Intent: {{ analysis.sbi.I }}%
                </li>
                <li><strong>Risk Score:</strong> 
                    <span class="{% if speaker.avg_risk_score >= 7 %}risk-high{% elif speaker.avg_risk_score >= 4 %}risk-medium{% else %}risk-low{% endif %}">
                        {{ speaker.avg_risk_score | round2 }}/10
                    </span>
                </li>
                <li><strong>Dominant SBI:</strong> {{ speaker.dominant_sbi | sbi_label }}</li>
            </ul>
        </div>
        {% endfor %}
    </div>

    <div class="section">
        <h2>Risk Distribution</h2>
        <table>
            <tr>
                <th>Risk Level</th>
                <th>Count</th>
                <th>Percentage</th>
            </tr>
            <tr>
                <td class="risk-high">HIGH</td>
                <td>{{ analysis.risk_distribution.HIGH }}</td>
                <td>{{ (analysis.risk_distribution.HIGH / (analysis.risk_distribution.HIGH + analysis.risk_distribution.MEDIUM + analysis.risk_distribution.LOW) * 100) | round2 }}%</td>
            </tr>
            <tr>
                <td class="risk-medium">MEDIUM</td>
                <td>{{ analysis.risk_distribution.MEDIUM }}</td>
                <td>{{ (analysis.risk_distribution.MEDIUM / (analysis.risk_distribution.HIGH + analysis.risk_distribution.MEDIUM + analysis.risk_distribution.LOW) * 100) | round2 }}%</td>
            </tr>
            <tr>
                <td class="risk-low">LOW</td>
                <td>{{ analysis.risk_distribution.LOW }}</td>
                <td>{{ (analysis.risk_distribution.LOW / (analysis.risk_distribution.HIGH + analysis.risk_distribution.MEDIUM + analysis.risk_distribution.LOW) * 100) | round2 }}%</td>
            </tr>
        </table>
    </div>

    <div class="section">
        <h2>Top Themes</h2>
        <ul>
            {% for theme in analysis.top_themes %}
            <li>{{ theme }}</li>
            {% endfor %}
        </ul>
    </div>

    <div class="section">
        <h2>Key Risks</h2>
        {% for risk in risks[:10] %}
        <div class="speaker-card">
            <p><strong>Speaker:</strong> {{ risk.speaker }}</p>
            <p><strong>Level:</strong> <span class="{% if risk.level == 'HIGH' %}risk-high{% elif risk.level == 'MEDIUM' %}risk-medium{% else %}risk-low{% endif %}">{{ risk.level }}</span></p>
            <p><strong>Description:</strong> {{ risk.description }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="section">
        <h2>Report Metadata</h2>
        <p><strong>Generated:</strong> {{ report.generated_at | format_date }}</p>
        <p><strong>Generated By:</strong> {{ report.generated_by }}</p>
        <p><strong>Version:</strong> {{ report.version }}</p>
    </div>
</body>
</html>
