<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comparative Analysis Report</title>
    <style>
        body { font-family: 'Times New Roman', serif; margin: 40px; line-height: 1.6; }
        .header { text-align: center; border-bottom: 2px solid #1F3864; padding-bottom: 20px; margin-bottom: 30px; }
        .section { margin-bottom: 30px; }
        .section h2 { color: #1F3864; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
        .session-card { border: 1px solid #ddd; padding: 15px; margin: 10px 0; background: #f9f9f9; }
        .comparison-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin: 20px 0; }
        .metric-positive { color: #228B22; font-weight: bold; }
        .metric-negative { color: #8B0000; font-weight: bold; }
        .key-finding { border-left: 4px solid #1F3864; padding-left: 15px; margin: 15px 0; background: #f0f4f8; }
        table { width: 100%; border-collapse: collapse; margin: 15px 0; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #1F3864; color: white; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Comparative Analysis Report</h1>
        <p><strong>Analysis Type:</strong> Multi-Session Comparison</p>
        <p><strong>Sessions Compared:</strong> {{ sessions | length }}</p>
        <p><strong>Generated:</strong> {{ report.generated_at | format_date }}</p>
    </div>

    {% if sessions | length >= 2 and sessions | length <= 4 %}
    <div class="section">
        <h2>Session Overview</h2>
        <div class="comparison-grid">
            {% for session in sessions %}
            <div class="session-card">
                <h3>{{ session.title }}</h3>
                <p><strong>Date:</strong> {{ session.date | format_date }}</p>
                <p><strong>Speakers:</strong> {{ session.speaker_count }}</p>
                <p><strong>Statements:</strong> {{ session.statement_count }}</p>
                <p><strong>Avg Risk:</strong> {{ session.avg_risk | round2 }}</p>
                <p><strong>Duration:</strong> {{ session.duration_minutes }} min</p>
            </div>
            {% endfor %}
        </div>
    </div>

    <div class="section">
        <h2>SBI Distribution Comparison</h2>
        <table>
            <tr>
                <th>Session</th>
                <th>Statement %</th>
                <th>Behavior %</th>
                <th>Intent %</th>
            </tr>
            {% for session in sessions %}
            <tr>
                <td>{{ session.title }}</td>
                <td>{{ session.sbi.S }}%</td>
                <td>{{ session.sbi.B }}%</td>
                <td>{{ session.sbi.I }}%</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Risk Profile Comparison</h2>
        <table>
            <tr>
                <th>Session</th>
                <th>Low Risk</th>
                <th>Medium Risk</th>
                <th>High Risk</th>
                <th>Avg Score</th>
            </tr>
            {% for session in sessions %}
            <tr>
                <td>{{ session.title }}</td>
                <td>{{ session.risk_distribution.LOW }}</td>
                <td>{{ session.risk_distribution.MEDIUM }}</td>
                <td>{{ session.risk_distribution.HIGH }}</td>
                <td class="{% if session.avg_risk >= 7 %}metric-negative{% elif session.avg_risk >= 4 %}metric-negative{% else %}metric-positive{% endif %}">
                    {{ session.avg_risk | round2 }}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Common Speakers Analysis</h2>
        <table>
            <tr>
                <th>Speaker</th>
                {% for session in sessions %}
                <th>{{ session.title | truncate(20) }}</th>
                {% endfor %}
                <th>Total Statements</th>
                <th>Risk Trend</th>
            </tr>
            {% for speaker in common_speakers %}
            <tr>
                <td>{{ speaker.name }}</td>
                {% for session_stat in speaker.session_stats %}
                <td>{{ session_stat.statements }}</td>
                {% endfor %}
                <td>{{ speaker.total_statements }}</td>
                <td class="{% if speaker.risk_trend > 0 %}metric-negative{% elif speaker.risk_trend < 0 %}metric-positive{% else %}{% endif %}">
                    {% if speaker.risk_trend > 0 %}↑{% elif speaker.risk_trend < 0 %}↓{% else %}→{% endif %} {{ speaker.risk_trend | round2 }}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Thematic Comparison</h2>
        <table>
            <tr>
                <th>Theme</th>
                {% for session in sessions %}
                <th>{{ session.title | truncate(15) }}</th>
                {% endfor %}
            </tr>
            {% for theme in shared_themes %}
            <tr>
                <td>{{ theme.name }}</td>
                {% for session_score in theme.scores %}
                <td>{{ session_score }}%</td>
                {% endfor %}
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Key Findings</h2>
        {% for finding in key_findings %}
        <div class="key-finding">
            <h3>{{ finding.title }}</h3>
            <p>{{ finding.description }}</p>
            <p><strong>Impact:</strong> {{ finding.impact }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="section">
        <h2>Top 3 Differences</h2>
        <ol>
            {% for diff in top_differences %}
            <li>
                <strong>{{ diff.metric }}:</strong> {{ diff.description }}
                <br>
                <span class="metric-positive">{{ diff.session_a }}: {{ diff.value_a }}</span> vs 
                <span class="metric-negative">{{ diff.session_b }}: {{ diff.value_b }}</span>
            </li>
            {% endfor %}
        </ol>
    </div>

    <div class="section">
        <h2>Convergence & Divergence Analysis</h2>
        <h3>Areas of Convergence</h3>
        <ul class="metric-positive">
            {% for area in convergence_areas %}
            <li>{{ area }}</li>
            {% endfor %}
        </ul>
        
        <h3>Areas of Divergence</h3>
        <ul class="metric-negative">
            {% for area in divergence_areas %}
            <li>{{ area }}</li>
            {% endfor %}
        </ul>
    </div>
    {% else %}
    <div class="section">
        <h2 style="color: #8B0000;">Invalid Session Count</h2>
        <p>Comparative analysis requires 2-4 sessions. Current count: {{ sessions | length }}</p>
    </div>
    {% endif %}

    <div class="section">
        <h2>Report Metadata</h2>
        <p><strong>Generated:</strong> {{ report.generated_at | format_date }}</p>
        <p><strong>Generated By:</strong> {{ report.generated_by }}</p>
        <p><strong>Version:</strong> {{ report.version }}</p>
    </div>
</body>
</html>
