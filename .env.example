# --- AI API Keys ---
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here

# --- Database & Cache ---
DATABASE_URL=postgresql+asyncpg://paxdata_user:paxdata_password@localhost:5432/paxdata_db
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# --- Operational Settings ---
BATCH_SIZE=100
WORKER_THREADS=4
QUALITY_THRESHOLD=0.85

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
REDIS_EXPORTER_PORT=9121
POSTGRES_EXPORTER_PORT=9187
CELERY_EXPORTER_PORT=8888
NODE_EXPORTER_PORT=9100
LOG_LEVEL=INFO

# --- HITL Dashboard ---
JWT_SECRET_KEY=change-me-in-production
REDIS_URL=redis://localhost:6379/0

# --- Data Retention Policy (TASK-1.3.1) ---
PAXDATA_RETENTION_RAW_TRANSCRIPT_YEARS=2
PAXDATA_RETENTION_AI_ANALYSIS_YEARS=5
PAXDATA_RETENTION_ANONYMIZED_STATISTICS_PERMANENT=true
PAXDATA_RETENTION_HITL_CORRECTIONS_PERMANENT=true
PAXDATA_RETENTION_ARCHIVE_AFTER_RETENTION=true
PAXDATA_RETENTION_ARCHIVE_CLEANUP_ENABLED=true

# --- Archive Configuration (TASK-1.3.2) ---
PAXDATA_ARCHIVE_S3_ENDPOINT_URL=http://localhost:9000
PAXDATA_ARCHIVE_S3_ACCESS_KEY=minioadmin
PAXDATA_ARCHIVE_S3_SECRET_KEY=minioadmin
PAXDATA_ARCHIVE_S3_BUCKET_NAME=paxdata-archives
PAXDATA_ARCHIVE_S3_REGION=us-east-1
PAXDATA_ARCHIVE_COMPRESSION=true
PAXDATA_ARCHIVE_ENCRYPTION_ENABLED=true
PAXDATA_ARCHIVE_ENCRYPTION_KEY=your-encryption-key-here

# --- PII Anonymization (TASK-1.3.3) ---
PAXDATA_PII_SPEAKER_NAME_ENCODING_PREFIX=P
PAXDATA_PII_LOCATION_GENERALIZATION_ENABLED=true
PAXDATA_PII_LOCATION_GENERALIZATION_LEVEL=country
PAXDATA_PII_GDPR_RIGHT_TO_BE_FORGOTTEN_ENABLED=true
PAXDATA_PII_DETECTION_MODEL=en_core_web_sm
